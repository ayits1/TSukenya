{
  "name": "tsukenya-portal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "tools/api-contracts"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "test": "node tests/sync-sim.js",
    "test:ui": "node tests/portal-ui.cjs",
    "test:budget:ui": "node tests/budget-break-even-ui.cjs",
    "test:crm:ui": "node tests/crm-ui.cjs",
    "test:customers:ui": "node tests/customers-ui.cjs",
    "test:layout:ui": "node tests/layout-ui.cjs",
    "test:workspace:ui": "node tests/workspace-ui.cjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "storybook": "npm run storybook --workspace frontend",
    "build:storybook": "npm run build-storybook --workspace frontend",
    "check:browser-policy": "node scripts/check-browser-policy.mjs",
    "check:frontend": "npm run check --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "test:components": "npm run test:components --workspace frontend",
    "test:visual": "npm run test:visual --workspace frontend",
    "test:visual:update": "npm run test:visual:update --workspace frontend",
    "test:full": "node scripts/full-check.mjs",
    "generate:api": "npm run generate --workspace @tsukenya/api-contracts && npm exec --workspace frontend -- prettier --write src/shared/api/generated.ts src/shared/api/crm.generated.ts src/shared/api/trading.generated.ts src/shared/api/abc.generated.ts src/shared/api/stock.generated.ts src/shared/api/receipt-pricing.generated.ts src/shared/api/purchases.generated.ts src/shared/api/sales.generated.ts src/shared/api/finance.generated.ts src/shared/api/staff.generated.ts src/shared/api/reports.generated.ts src/shared/api/tradingFreshness.generated.ts",
    "test:catalog:ui": "node tests/catalog-ui.cjs",
    "test:labels:ui": "node tests/labels-ui.cjs",
    "test:promotion:legacy": "node tests/promotion-legacy.cjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
