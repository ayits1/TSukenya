{
  "openapi": "3.1.0",
  "info": {
    "title": "TSukenya bounded trading reports",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/trading/reports/summary": {
      "get": {
        "operationId": "reportSummary",
        "description": "Current READ ONLY REPEATABLE READ; independent reads may differ. Full-filter totals. Owner/manager/accountant scoped; payroll rows and bonus excluded for manager.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "enum": [
                "period",
                "balances"
              ]
            }
          },
          {
            "name": "store",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current accounting-date read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters"
          },
          "403": {
            "description": "Role/section forbidden"
          }
        }
      }
    },
    "/api/v1/trading/reports/rows": {
      "get": {
        "operationId": "reportRows",
        "description": "Current READ ONLY REPEATABLE READ; independent reads may differ. Full-filter totals. Owner/manager/accountant scoped; payroll rows and bonus excluded for manager.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "enum": [
                "period",
                "balances"
              ]
            }
          },
          {
            "name": "store",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "products",
                "by_store",
                "expenses_by_category",
                "cashiers",
                "stock",
                "cash",
                "debts",
                "advances",
                "payroll_debts"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current accounting-date read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters"
          },
          "403": {
            "description": "Role/section forbidden"
          }
        }
      }
    },
    "/api/v1/trading/reports/export.csv": {
      "get": {
        "operationId": "reportCsv",
