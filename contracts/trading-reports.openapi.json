            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "products",
                "by_store",
                "expenses_by_category",
                "cashiers",
                "stock",
                "cash",
                "debts",
                "advances",
                "payroll_debts",
                "summary",
                "all"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current accounting-date read",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters"
          },
          "403": {
            "description": "Role/section forbidden"
          }
        }
      }
    }
