          "binding": {
            "type": "string"
          },
          "parts": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ReplenishmentGroups": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "page",
          "pages",
          "limit",
          "policy",
          "query",
          "asOf",
          "items",
          "summary"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [
              30
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/PurchasePolicy"
          },
          "query": {
            "$ref": "#/components/schemas/ReplenishmentQuery"
          },
          "asOf": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplenishmentGroup"
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groups",
              "lines",
              "covered",
              "total"
            ],
            "properties": {
              "groups": {
                "type": "integer",
                "minimum": 0
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              },
              "covered": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "string"
              }
            }
          }
        }
      },
      "ReplenishmentLines": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "page",
          "pages",
          "limit",
          "policy",
          "query",
          "group",
          "binding",
          "items",
          "asOf"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [
              30
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/PurchasePolicy"
          },
          "query": {
            "$ref": "#/components/schemas/ReplenishmentSelection"
          },
          "group": {
            "$ref": "#/components/schemas/ReplenishmentGroup"
          },
          "binding": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplenishmentLine"
            }
          },
          "asOf": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ReplenishmentDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "binding",
