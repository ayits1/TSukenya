            "description": "store"
          },
          {
            "name": "warehouse",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "description": "warehouse"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "page"
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh scoped RR read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplenishmentGroups"
                }
              }
            }
          },
          "403": {
            "description": "Current role or scope denied"
          },
          "409": {
            "description": "Replenishment group changed; explicit refresh required"
          }
        }
      }
    },
    "/api/v1/trading/purchases/replenishment/lines": {
