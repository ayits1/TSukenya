          "binding": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplenishmentLine"
            }
          },
          "policy": {
            "$ref": "#/components/schemas/PurchasePolicy"
          },
          "part": {
            "type": "integer",
            "minimum": 1
          },
          "parts": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [
              200
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
