  "components": {
    "schemas": {
      "PurchasePolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "store",
          "documentKinds"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "warehouse"
            ]
          },
          "store": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "documentKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "purchase_order",
                "receipt",
                "supplier_return"
              ]
            }
          }
        }
      },
      "PurchaseQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "store",
          "status",
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "store": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "",
              "draft",
              "posted",
              "reversed"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "",
              "purchase_order",
              "receipt",
              "supplier_return"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "ReplenishmentQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "store",
          "warehouse"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "store": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "warehouse": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "ReplenishmentSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "store",
          "warehouse",
          "party"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "store": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "warehouse": {
            "type": "integer",
            "minimum": 1
          },
          "party": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "PurchaseDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "kind",
          "status",
          "date",
          "store",
          "storeName",
          "party",
          "partyName",
          "total",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "purchase_order",
              "receipt",
              "supplier_return"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "posted",
              "reversed"
            ]
          },
          "date": {
            "type": "string"
          },
          "store": {
            "type": "integer",
            "minimum": 1
          },
          "storeName": {
            "type": "string"
          },
          "party": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "partyName": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PurchaseDocuments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "page",
          "pages",
          "limit",
          "policy",
          "query",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [
              30
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/PurchasePolicy"
          },
          "query": {
            "$ref": "#/components/schemas/PurchaseQuery"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseDocument"
            }
          }
        }
      },
      "ReplenishmentLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "name",
          "unit",
          "quantity",
          "price",
          "available",
          "minimum",
          "onOrder",
          "costKnown"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "available": {
            "type": "string"
          },
          "minimum": {
            "type": "string"
          },
          "onOrder": {
            "type": "string"
          },
          "costKnown": {
            "type": "boolean"
          }
        }
      },
      "ReplenishmentGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "store",
          "storeName",
          "warehouse",
          "warehouseName",
          "party",
          "partyName",
          "linesCount",
          "total",
          "preview",
          "binding",
          "parts"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "store": {
            "type": "integer",
            "minimum": 1
          },
          "storeName": {
            "type": "string"
          },
          "warehouse": {
            "type": "integer",
            "minimum": 1
          },
          "warehouseName": {
            "type": "string"
          },
          "party": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "partyName": {
            "type": "string"
