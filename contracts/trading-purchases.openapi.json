{
  "openapi": "3.1.0",
  "info": {
    "title": "TSukenya purchases workspace",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/trading/purchases/documents": {
      "get": {
        "operationId": "purchaseDocuments",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "q"
          },
          {
            "name": "store",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "description": "store"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "",
                "draft",
                "posted",
                "reversed"
              ]
            },
            "description": "status"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "",
                "purchase_order",
                "receipt",
                "supplier_return"
              ]
            },
            "description": "kind"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "from"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "to"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "page"
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh scoped RR read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseDocuments"
                }
              }
            }
          },
          "403": {
            "description": "Current role or scope denied"
          },
          "409": {
            "description": "Replenishment group changed; explicit refresh required"
          }
        }
      }
    },
