    "/api/erp/entities/{type}": {
      "post": {
        "operationId": "createEntityWithReceipt",
        "description": "Create with immutable UUID receipt. Legacy no-key creates and revision-bound updates retain legacy contracts. Current actor/role/store policy under ledger lock before receipt lookup.",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "stores",
                "warehouses",
                "accounts",
                "employees",
                "parties"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable acknowledgement; current row must be read separately",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityCreateAcknowledgement"
                }
              }
            }
          },
          "400": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trading/entities/{type}/identity": {
      "post": {
        "operationId": "readEntityCreateIdentity",
        "description": "CSRF-protected non-business read, real READ ONLY REPEATABLE READ. Exact original UUID/body/author/resource and current policy required. Does not create, mutate, audit or adopt a current revision.",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "stores",
                "warehouses",
                "accounts",
                "employees",
                "parties"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request"
                ],
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/EntityCreateRequest"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable acknowledgement; current row must be read separately",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityCreateIdentity"
                }
              }
            }
          },
          "400": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Current policy/CSRF or conflict refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/erp/vouchers/recovery-context": {
      "get": {
        "operationId": "voucherDraftContext",
        "description": "Read-only fresh actor/scope authorization. Invalid raw date, closed period or inactive store return canEdit false without denying draft viewing. No write or revision adoption.",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "store",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expense_scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoucherDraftContext"
                }
              }
            }
          },
          "400": {
            "description": "Invalid context"
          },
          "403": {
            "description": "Role/store access denied"
          }
        }
      }
    },
    "/api/erp/vouchers": {
      "post": {
        "operationId": "createNativeVoucher",
        "description": "Atomic voucher CREATE remains the legacy contract. A bound 400 proof means this HTTP attempt rolled back; it never proves absence of an earlier request with the same key.",
        "responses": {
          "201": {
            "description": "Legacy user-policy-redacted voucher ACK with request_key"
          },
          "400": {
            "description": "Validation error; optional bound no-write proof",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/VoucherCreateRejected"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Authorization failure without no-write proof"
          },
          "409": {
            "description": "Conflict without no-write proof"
          }
        }
      }
    },
    "/api/v1/trading/entities/{type}/recovery-context": {
      "get": {
        "operationId": "entityRecoveryContext",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "stores",
                "warehouses",
                "accounts",
                "employees",
                "parties"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "store",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh read-only resource authorization, without validating newer raw fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityRecoveryContext"
                }
              }
            }
          },
          "403": {
            "description": "Resource scope unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DirectoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "store_id": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "supplier",
              "customer",
              "cash",
              "bank",
              "terminal"
            ]
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "promotion": {
            "type": "boolean"
          },
          "cost": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "regularPrice": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "salePrice": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "shift_rate": {
            "type": "string"
          },
          "bonus_percent": {
            "type": "string"
          },
          "bonus_basis": {
            "type": "string",
            "enum": [
              "store",
              "personal",
              "profit"
            ]
          },
          "balance": {
            "type": "string"
          },
          "payroll_debt": {
            "type": "string"
          },
          "semantic_key": {
            "type": "string"
          },
          "account_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DirectoryType": {
        "type": "string",
        "enum": [
          "stores",
          "warehouses",
          "accounts",
          "employees",
          "parties",
          "products",
          "expense_categories",
          "cash_shifts"
        ]
      },
      "DirectoryPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pages",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/DirectoryItem"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "const": 30
          }
        }
      },
      "DirectoryRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DirectoryType"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "DirectoryDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "name"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DirectoryType"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "store_id": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "supplier",
              "customer",
              "cash",
              "bank",
              "terminal"
            ]
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "promotion": {
            "type": "boolean"
          },
          "cost": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "regularPrice": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "salePrice": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "shift_rate": {
            "type": "string"
          },
          "bonus_percent": {
            "type": "string"
          },
          "bonus_basis": {
            "type": "string",
            "enum": [
              "store",
              "personal",
              "profit"
            ]
          },
          "balance": {
            "type": "string"
          },
          "payroll_debt": {
            "type": "string"
          },
          "semantic_key": {
            "type": "string"
          },
          "account_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DirectoryDetailsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/DirectoryRef"
            }
          },
          "store": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "DirectoryDetails": {
        "type": "object",
        "required": [
          "items",
          "unavailable"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/DirectoryDetail"
            }
          },
          "unavailable": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/DirectoryRef"
            }
          }
        }
      },
      "TradingBootstrap": {
        "type": "object",
        "required": [
          "csrf",
          "role",
          "username",
          "storeId",
          "defaultStoreId",
          "canViewAudit",
          "closed_through",
          "fiscal_required",
          "max_discount",
          "defaultCategoryId"
        ],
        "properties": {
          "csrf": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "warehouse",
              "cashier",
              "accountant"
            ]
          },
          "username": {
            "type": "string"
          },
          "storeId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "defaultStoreId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "canViewAudit": {
            "type": "boolean"
          },
          "closed_through": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "fiscal_required": {
            "type": "boolean"
          },
          "max_discount": {
            "type": "string"
          },
          "alerts_status": {
            "type": "object",
            "additionalProperties": true
          },
          "defaultCategoryId": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
