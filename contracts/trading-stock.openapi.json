              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StockPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["owner", "manager", "warehouse", "cashier", "accountant"]
          },
          "store": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "costVisible": {
            "type": "boolean"
          },
          "canEditAssortment": {
            "type": "boolean"
          },
          "documentKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "opening",
                "transfer",
                "writeoff",
                "inventory",
                "production"
              ]
            }
          },
          "canControl": {
            "type": "boolean"
          },
          "canLegacyRecipes": {
            "type": "boolean"
          },
          "canRecipeVersions": {
            "type": "boolean"
          },
          "canReplenish": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "store",
          "costVisible",
          "canEditAssortment",
          "documentKinds",
          "canControl",
          "canLegacyRecipes",
          "canRecipeVersions",
          "canReplenish"
        ]
      },
      "StockQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string"
          },
          "store": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "warehouse": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "view": {
            "type": "string",
            "enum": ["totals", "lots"]
          }
        },
        "required": ["q", "store", "warehouse", "view"]
      },
      "StockTotal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "warehouse": {
            "type": "integer",
            "minimum": 1
          },
          "product": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "sold": {
            "type": "boolean"
          },
          "low": {
            "type": "boolean"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "available": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "minimum": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "value": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        },
        "required": [
          "warehouse",
          "product",
          "name",
          "unit",
          "sold",
          "low",
          "quantity",
          "available",
          "reserved",
          "minimum"
        ]
      },
      "StockLot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "warehouse": {
            "type": "integer",
            "minimum": 1
          },
          "product": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "lot": {
            "type": "string"
          },
          "expiry": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "expired": {
            "type": "boolean"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "available": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{3}$"
          },
          "value": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        },
        "required": [
          "id",
          "warehouse",
          "product",
          "name",
          "unit",
          "lot",
          "expiry",
          "expired",
          "quantity",
          "available",
          "reserved"
        ]
      },
      "StockSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "products": {
            "type": "integer",
            "minimum": 0
          },
          "low": {
            "type": "integer",
            "minimum": 0
          },
          "lots": {
            "type": "integer",
            "minimum": 0
          },
          "expiry": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        },
        "required": ["products", "low", "lots", "expiry"]
      },
      "StockPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [30]
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/StockTotal"
                },
                {
                  "$ref": "#/components/schemas/StockLot"
                }
              ]
            }
          },
          "view": {
            "type": "string",
            "enum": ["totals", "lots"]
          },
          "summary": {
            "$ref": "#/components/schemas/StockSummary"
          },
          "query": {
            "$ref": "#/components/schemas/StockQuery"
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "policy": {
            "$ref": "#/components/schemas/StockPolicy"
          },
          "alerts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ok": {
                "type": "object",
                "additionalProperties": true,
                "nullable": true
              },
              "error": {
                "type": "object",
                "additionalProperties": true,
                "nullable": true
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": ["ok", "error", "stale"],
            "nullable": true
          }
        },
        "required": [
          "total",
          "page",
          "pages",
          "limit",
          "items",
          "view",
          "summary",
          "query",
          "asOf",
          "policy",
          "alerts"
        ]
      },
      "AssortmentRow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "default_min": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,3})?$"
          },
          "sold": {
            "type": "boolean"
          },
          "min_stock": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,3})?$",
            "nullable": true
          },
          "minimum": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,3})?$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "nullable": true
          }
        },
        "required": [
          "product",
          "name",
          "unit",
          "default_min",
          "sold",
          "min_stock",
          "minimum",
          "revision"
        ]
      },
      "AssortmentPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
