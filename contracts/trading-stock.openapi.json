    "/api/v1/trading/assortment/identity": {
      "post": {
        "operationId": "assortmentRecoveryIdentity",
        "responses": {
          "200": {
            "description": "Поточний дозвіл або exact підтвердження",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentRecoveryIdentity"
                }
              }
            }
          },
          "400": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["request"],
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/AssortmentRecoveryRequest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trading/assortment/execute": {
      "post": {
        "operationId": "assortmentRecoveryExecute",
        "responses": {
          "200": {
            "description": "Поточний дозвіл або exact підтвердження",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentRecoveryAck"
                }
              }
            }
          },
          "400": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    },
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryRejection"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
