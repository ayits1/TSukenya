{
  "openapi": "3.0.3",
  "info": {
    "title": "TSukenya React Stock",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/trading/stock": {
      "get": {
        "responses": {
          "200": {
            "description": "Current scoped RR snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockPage"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "warehouse",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["totals", "lots"]
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["warehouse_product"]
            }
          }
        ]
      }
    },
    "/api/v1/trading/assortment": {
      "get": {
        "responses": {
          "200": {
            "description": "Current scoped RR snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentPage"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "warehouse",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "product",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["name"]
            }
          }
        ]
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssortmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved current row, not an immutable receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentAck"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trading/stock/documents": {
      "get": {
        "responses": {
          "200": {
            "description": "Current scoped RR snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockDocuments"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["", "draft", "posted", "reversed"]
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/trading/stock.csv": {
      "get": {
        "responses": {
          "200": {
            "description": "Whole filtered streamed CSV, private costs only when authorized",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "warehouse",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["totals"]
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["warehouse_product"]
            }
          }
        ]
      }
    },
    "/api/v1/trading/assortment/recovery-context": {
      "get": {
        "operationId": "assortmentRecoveryRecoveryContext",
        "responses": {
          "200": {
            "description": "Поточний дозвіл або exact підтвердження",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentRecoveryContext"
                }
              }
            }
          },
          "400": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "warehouse",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/trading/assortment/current": {
      "get": {
        "operationId": "assortmentRecoveryCurrent",
        "responses": {
