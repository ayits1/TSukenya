                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Поточна відмова або bound rollback proof; звичайна відмова не підтверджує відсутність запису.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssortmentRecoveryError"
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "warehouse",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "product",
            "in": "query",
