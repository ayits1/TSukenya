{
  "openapi": "3.1.0",
  "info": {
    "title": "Scoped contact work",
    "version": "1.0.0",
    "description": "Owner/manager/accountant only. Each read READ ONLY repeatable snapshot. No messages/loyalty. Identity false never proves absence. Immutable customer/store and creator-bound exact normalized receipts."
  },
