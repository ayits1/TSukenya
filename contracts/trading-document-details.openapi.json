                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "context", "document", "sections", "page"],
        "properties": {
          "contract": {
            "type": "string",
            "enum": ["document-detail-v1"]
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document", "role", "scopeStore", "store", "readAt"],
            "properties": {
              "document": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "manager",
                  "warehouse",
                  "cashier",
                  "accountant"
                ]
              },
              "scopeStore": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "store": {
                "type": "integer",
                "minimum": 1
              },
              "readAt": {
                "type": "string"
              }
            }
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "total"],
              "properties": {
                "key": {
                  "$ref": "#/components/schemas/Section"
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "page": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "page", "pages", "limit", "total", "items"],
            "properties": {
              "section": {
                "$ref": "#/components/schemas/Section"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "pages": {
                "type": "integer",
                "minimum": 1
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "enum": [10, 30]
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Line"
                    },
                    {
                      "$ref": "#/components/schemas/StockMovement"
                    },
                    {
                      "$ref": "#/components/schemas/CashMovement"
                    },
                    {
                      "$ref": "#/components/schemas/Allocation"
                    },
                    {
                      "$ref": "#/components/schemas/PayrollCalculation"
                    },
                    {
                      "$ref": "#/components/schemas/ProductionComponent"
                    },
                    {
                      "$ref": "#/components/schemas/OrderLine"
                    },
                    {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
