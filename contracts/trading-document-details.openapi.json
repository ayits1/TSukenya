{
  "openapi": "3.1.0",
  "info": {
    "title": "TSukenya bounded document view",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/trading/documents/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Поточний дозволений стан документа. Секції читаються окремими обмеженими сторінками.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Header"
                }
              }
            }
          },
          "400": {
            "description": "Некоректний запит"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Доступ змінився"
          }
        }
      }
    },
    "/api/v1/trading/documents/{id}/rows": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Section"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [10, 30],
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Поточний дозволений стан документа. Секції читаються окремими обмеженими сторінками.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Некоректний запит"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Доступ змінився"
          }
        }
      }
    }
  },
