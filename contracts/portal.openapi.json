{
  "openapi": "3.1.0",
  "info": {
    "title": "TSukenya compact portal",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/portal/state": {
      "get": {
        "operationId": "portalState",
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          },
          "304": {
            "description": "Незмінний компактний стан; без JSON тіла"
          }
        }
      }
    },
    "/api/v1/portal/overview": {
      "get": {
        "operationId": "portalSummary",
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/catalogue-model": {
      "get": {
        "operationId": "portalCatalogueModel",
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogueModel"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/examples": {
      "get": {
        "operationId": "portalExamples",
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Examples"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/portal/sales-margin": {
      "get": {
        "operationId": "portalSalesMargin",
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesMargin"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/examples/delete": {
      "post": {
        "operationId": "deleteExamples",
        "description": "Frozen revision/UUID пакет; authoritative existing stock/recipe/production/campaign guards; exact повтор повертає receipt, а не видаляє вдруге.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "id",
                        "revision"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "idempotencyKey",
                  "items"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "idempotencyKey": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 30,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "enum": [
                              "deleted",
                              "rejected",
                              "conflicted"
                            ]
                          },
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "status"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "idempotencyKey",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Лише current owner"
          },
          "409": {
            "description": "Idempotency conflict"
          }
        }
      }
    },
    "/api/v1/portal/catalogue.csv": {
      "get": {
        "operationId": "exportCatalogue",
        "description": "Explicit streamed CSV, generator owns RR/READ ONLY snapshot, batches100, fresh role/cost policy and versioned formula guard. Not automatic sync/backup.",
        "parameters": [
          {
            "name": "includeHidden",
            "in": "query",
            "schema": {
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "store",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role-aware CSV; cashier has no cost/markup",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/catalog/pricing/preview": {
      "post": {
        "operationId": "previewFilteredPrices",
        "description": "Additive selection instead of ids, same helper as paged catalogue, all matching ≤1000 IDs. Preview scope names store/category/promotion; commit freezes matching IDs/prices/Kyiv day plus existing full catalogue/settings revision. Existing ids/null retained.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "markup"
                  },
                  "selection": {
                    "$ref": "#/components/schemas/PricingSelection"
                  },
                  "markup": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                  },
                  "resetManualPrices": {
                    "type": "boolean"
                  },
                  "updateDefault": {
                    "const": false
                  }
                },
                "required": [
                  "kind",
                  "selection",
                  "markup",
                  "resetManualPrices",
                  "updateDefault"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing pricing review DTO plus scope {kind,count,filters,storeName}"
          },
          "400": {
            "description": "Invalid/empty/over1000 selection"
          }
        }
      }
    },
    "/api/v1/portal/records/{collection}/{id}": {
      "get": {
        "operationId": "portalLegacyRecord",
        "description": "Read-only exact record in a current permission/store snapshot. No writes or audit. Managed/linked tasks cannot use the generic editor.",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "tasks",
                "ideas",
                "expenses"
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,120}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyRecord"
                }
              }
            }
          },
          "403": {
            "description": "Current role/store denied"
          },
          "409": {
            "description": "Record no longer exists"
          }
        }
      }
    },
    "/api/v1/portal/budget-template": {
      "get": {
        "operationId": "getBudgetTemplate",
        "description": "Network owner only. Read-only count inferred by the existing legacy precedence; independent from Label Studio revision.",
        "responses": {
          "200": {
            "description": "Авторитетна кількість і поточні права",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetTemplate"
                }
              }
            }
          },
          "403": {
            "description": "Current role or network scope unavailable"
          }
        }
      },
      "patch": {
        "operationId": "saveBudgetTemplate",
        "description": "Network owner and current actor checked after ledger lock. Updates only budgetStores; preserves unrelated settings. Stale/unknown acknowledgement requires explicit read and local comparison before a separate Save.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BudgetTemplateWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Авторитетна кількість і поточні права",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetTemplate"
                }
              }
            }
          },
          "400": {
            "description": "Malformed count or revision"
          },
          "403": {
            "description": "Current role or network scope unavailable"
          },
          "428": {
            "description": "Missing observed revision"
          },
          "409": {
            "description": "Stale template revision; draft preserved"
          }
        }
      }
    },
    "/api/v1/portal/create-identity": {
      "get": {
        "operationId": "legacyCreateIdentity",
        "description": "Read-only REPEATABLE READ snapshot under current actor/author/store policy. Identity confirms the original CREATE, never adopts a current Save revision. Deleted original is never resurrected. Nullable original means historical receipt without snapshot; no comparison baseline is invented.",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "tasks",
                "ideas",
                "expenses"
              ]
            }
          },
          {
            "name": "createKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,80}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt identity (no writes or audit)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyCreateIdentity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "403": {
            "description": "Current role/store/original scope refused"
          },
          "409": {
            "description": "Author/resource key collision"
          }
        }
      }
    },
    "/api/{collection}": {
      "post": {
        "operationId": "legacyImmutableCreate",
        "description": "Existing legacy CREATE with immutable Idempotency-Key. Exact same author/resource/request replay returns original identity without mutation or audit. Changed/deleted original refuses overwrite/resurrection. Current role/store checked after ledger lock. Original nullable only for historical receipts; read identity separately, never invent baseline.",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "tasks",
                "ideas",
                "expenses"
              ]
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Existing collection editable fields; server task scope/expense Decimal normalization remains authoritative."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original identity acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyCreateAcknowledgement"
                }
              }
            }
          },
          "403": {
            "description": "Current policy refused"
          },
          "409": {
            "description": "Key/payload collision or changed/deleted original"
          }
        }
      }
    },
    "/api/v1/portal/metadata": {
      "get": {
        "operationId": "portalMetadataV2",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataV2"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          },
          "304": {
            "description": "Unchanged scoped validator, no collection scan"
          }
        }
      }
    },
    "/api/v1/portal/collections/tasks": {
      "get": {
        "operationId": "portalTasksPage",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "space",
            "schema": {
              "enum": [
                "operations",
                "development"
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "all",
                "todo",
                "doing",
                "done"
              ]
            }
          },
          {
            "in": "query",
            "name": "stage",
            "schema": {
              "enum": [
                "all",
                "unknown",
                "1",
                "2",
                "3",
                "4"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionPage"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/collections/ideas": {
      "get": {
        "operationId": "portalIdeasPage",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "reaction",
            "schema": {
              "enum": [
                "all",
                "awaiting",
                "yes",
                "no"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionPage"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/collections/expenses": {
      "get": {
        "operationId": "portalExpensesPage",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "group",
            "schema": {
              "enum": [
                "all",
                "fixed",
                "variable"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionPage"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/collections/tasks/{id}": {
      "get": {
        "operationId": "portalPinnedTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,120}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionItem"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    },
    "/api/v1/portal/collections/summary": {
      "get": {
        "operationId": "portalCollectionSummary",
        "parameters": [
          {
            "in": "query",
            "name": "section",
            "schema": {
              "enum": [
                "operations",
                "development",
                "budget"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent current RR READ ONLY snapshot; not a persisted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні фільтри"
          },
          "401": {
            "description": "Сеанс завершено"
          },
          "403": {
            "description": "Недостатньо прав"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "State": {
        "type": "object",
        "properties": {
          "contract": {
            "const": "portal-metadata-v1"
          },
          "role": {
            "enum": [
              "owner",
              "manager",
              "cashier",
              "warehouse",
              "accountant"
            ]
          },
          "networkOwner": {
            "type": "boolean"
          },
          "csrf": {
            "type": "string"
          },
          "labelRevision": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "ideas": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "expenses": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "settings/main": {
                "type": "object"
              },
              "project/state": {
                "type": "object"
              }
            },
            "required": [
              "tasks",
              "ideas",
              "expenses",
              "settings/main",
              "project/state"
            ],
            "additionalProperties": false
          },
          "stateVersions": {
            "type": "object",
            "properties": {
              "products": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "references": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "tasks": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ideas": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "expenses": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "settings/main": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "project/state": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "products",
              "references",
              "tasks",
              "ideas",
              "expenses",
              "settings/main",
              "project/state"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "contract",
          "role",
          "networkOwner",
          "csrf",
          "labelRevision",
          "data"
        ],
        "additionalProperties": false
      },
      "Summary": {
        "type": "object",
        "properties": {
          "catalogCount": {
            "type": "integer",
            "minimum": 0
          },
          "noPriceCount": {
            "type": "integer",
            "minimum": 0
          },
          "stalePriceCount": {
            "type": "integer",
            "minimum": 0
          },
          "exampleCount": {
            "type": "integer",
            "minimum": 0
          },
          "allExampleCount": {
            "type": "integer",
            "minimum": 0
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "nextChangeAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "priceBasis": {
            "const": "legacy_product_promotion"
          },
          "staleBasis": {
            "const": "elapsed_24h_strict_greater"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "plannedExpenses": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "required": [
          "catalogCount",
          "noPriceCount",
          "stalePriceCount",
          "exampleCount",
          "allExampleCount",
          "generatedAt",
          "nextChangeAt",
          "priceBasis",
          "staleBasis",
          "revision"
        ],
        "additionalProperties": false
      },
      "CatalogueModel": {
        "type": "object",
        "properties": {
          "catalogCount": {
            "type": "integer",
            "minimum": 0
          },
          "noPriceCount": {
            "type": "integer",
