  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "name",
          "type",
          "category",
          "pack",
          "size",
          "unit",
          "barcode",
          "priceAt",
          "cost",
          "markup",
          "price",
          "salePrice",
          "manualPrice",
          "promotion",
          "minStock"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "priceAt": {
            "type": "string"
          },
          "cost": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "markup": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "salePrice": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "manualPrice": {
            "type": "boolean"
          },
          "promotion": {
            "type": "boolean"
          },
          "minStock": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pages",
          "limit",
          "facets",
          "canEdit",
          "defaultMarkup"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "enum": [
              10,
              20,
              50
            ]
          },
          "facets": {
            "type": "object",
            "required": [
              "type",
              "category",
              "pack"
            ],
            "properties": {
              "type": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "category": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pack": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "canEdit": {
            "type": "boolean"
          },
          "defaultMarkup": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        }
      },
      "ProductCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "cost": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "markup": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "price": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "manualPrice": {
            "type": "boolean"
          },
          "promotion": {
            "type": "boolean"
          },
          "priceAt": {
            "type": "string"
          },
          "priceReviewed": {
            "type": "boolean"
          },
          "minStock": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        },
        "additionalProperties": false
      },
      "ProductPatch": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "cost": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "markup": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "price": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "manualPrice": {
            "type": "boolean"
          },
          "promotion": {
            "type": "boolean"
          },
          "priceAt": {
            "type": "string"
          },
          "priceReviewed": {
            "type": "boolean"
          },
          "minStock": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "role",
          "csrf"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "warehouse",
              "cashier",
              "accountant"
            ]
          },
          "csrf": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true,
            "type": "boolean"
          }
        }
      }
    }
