FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f
WORKDIR /workspace
ENV CI=1 STORYBOOK_DISABLE_TELEMETRY=1
COPY package.json package-lock.json .npmrc ./
COPY frontend/package.json frontend/package.json
COPY tools/api-contracts/package.json tools/api-contracts/package.json
RUN npm ci
COPY frontend/ frontend/
COPY tests/sync-sim.js tests/sync-harness.js tests/
COPY tests/fixtures/ tests/fixtures/
COPY app/portal.js app/portal.js
# check:frontend already checked TypeScript; build Vite without repeating tsc.
RUN npm run check:frontend && npm run test:frontend && npm test && npm exec --workspace frontend -- vite build && npm run build:storybook
CMD ["sh", "-c", "npm run test:components && npm run test:visual"]
